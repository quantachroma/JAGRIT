# ==========================================
# JAGRIT SIH Project - Environment Variables
# Copy this file to .env and add your keys
# ==========================================

# --- SUPABASE (Database, Auth, pgvector) ---
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-backend"

# --- BACKEND (FastAPI & Celery) ---
REDIS_URL="redis://localhost:6379/0"
DATABASE_URL="postgresql://postgres:password@localhost:5432/jagrit" # Or Supabase connection string

# --- EXTERNAL APIs ---
BHASHINI_API_KEY="your-bhashini-api-key"
META_WHATSAPP_TOKEN="your-whatsapp-api-token"